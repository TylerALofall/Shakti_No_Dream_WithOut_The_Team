# shakti-ticket-dealer config -- spec v2.0
# Run from the repo root: shakti-ticket-dealer Tools/Builders/Ticket-Dealer/J.config

# PART 1: what to count
RECORD_STAMP  = <SECTION
CHECKPOINT    = file_name
UNIT_MARKER   = function_order
UNIT_START    = 1
TOTAL_MARK    = total_items

# PART 2: how to deal
MAX_UNITS     = 20

# PART 3: what to say
INPUT         = Copilot_Intake/J_WORK.xml
INSTRUCTIONS  = Copilot_Intake/QA_specialist_Instruction.md
TEMPLATE      = Tools/Builders/Ticket-Dealer/ticket_template.txt
PREFIX        = WO
SOURCE_PREFIX = SECTION-
OUT_DIR       = Tickets/J
DATE          = 2026-09-29
